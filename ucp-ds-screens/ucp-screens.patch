+}
+
+export interface UcpActivity {
+  id:        string
+  channel:   ActivityChannel
+  title:     string
+  meta:      string
+  timestamp: string
+  state:     { label: string; variant: TagVariantLite }
+  /** Written by the record's assigned agent — rendered as EntityList's aiInsight. */
+  aiSummary?: string
+}
+
