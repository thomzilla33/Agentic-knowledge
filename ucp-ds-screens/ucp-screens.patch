+        />
+      )}
+
+      {/* ── Filter slot dropdowns ── */}
+      {openSlot && anchor && (
+        <>
+          <div className="fixed inset-0 z-[10000]" onClick={closeSlot} />
+          <div ref={dropdown.ref} style={{ position: "fixed", zIndex: 10001, ...dropdown.style }}>
+            <Menu>
+              {openSlot === "sort"
